<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TunnelTimer.App.Views.WidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="18,10,18,14" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PhaseStates">
                <VisualState x:Name="Upcoming" />
                <VisualState x:Name="Imminent">
                    <VisualState.Setters>
                        <Setter Target="TimeTextBlock.Foreground" Value="{ThemeResource PhaseImminentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Overdue">
                    <VisualState.Setters>
                        <Setter Target="TimeTextBlock.Foreground" Value="{ThemeResource PhaseOverdueBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.Resources>
            <!--
                Slides the spectrum by exactly one of its two runs, every three seconds, forever. A
                render transform is animated by the compositor, off the UI thread, so it does
                not compete with the countdown.
            -->
            <Storyboard x:Name="GripStoryboard" RepeatBehavior="Forever">
                <DoubleAnimation
                    Storyboard.TargetName="GripShift"
                    Storyboard.TargetProperty="X"
                    From="-56"
                    To="0"
                    Duration="0:0:3" />
            </Storyboard>
        </Grid.Resources>

        <!--
            Grip: signals that the widget can be dragged, and carries the brand spectrum. The
            spectrum is twice as wide as the grip, which clips it to its rounded shape. The
            Canvas matters: a panel that sizes its children clips an oversized child in the
            child's own coordinates, so the cut-out would slide along with the spectrum.
        -->
        <Grid
            Grid.Row="0"
            Width="56"
            Height="6"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            CornerRadius="3">
            <Canvas>
                <Rectangle
                    Width="112"
                    Height="6"
                    Fill="{ThemeResource RainbowLoopBrush}">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="GripShift" X="-56" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>
        </Grid>

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            MaxLines="1"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />

        <!--
            The font size steps down for a three digit overdue time instead of scaling the
            text: scaled text lands between pixels and loses its sharp edges.
        -->
        <TextBlock
            x:Name="TimeTextBlock"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource DisplayFontFamily}"
            FontSize="{x:Bind TimeFontSize(ViewModel.TimeText), Mode=OneWay}"
            FontWeight="Bold"
            Foreground="{ThemeResource PhaseUpcomingBrush}"
            Text="{x:Bind ViewModel.TimeText, Mode=OneWay}"
            Typography.NumeralAlignment="Tabular" />

        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource SecondaryTextBrush}"
            Text="{x:Bind ViewModel.StartText, Mode=OneWay}" />

        <!-- Without a link: "I'm in". With a link: "Join meeting" plus "I'm already in". -->
        <StackPanel x:Name="ActionsPanel" Grid.Row="4" Spacing="2">
            <Button
                x:Uid="AcknowledgeButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.AcknowledgeCommand}"
                Style="{StaticResource PillAccentButtonStyle}"
                Visibility="{x:Bind VisibleWhenFalse(ViewModel.HasLink), Mode=OneWay}" />
            <Button
                x:Uid="JoinButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.JoinCommand}"
                Style="{StaticResource PillAccentButtonStyle}"
                Visibility="{x:Bind ViewModel.HasLink, Mode=OneWay}" />
            <HyperlinkButton
                x:Uid="AlreadyInButton"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.AcknowledgeCommand}"
                Visibility="{x:Bind ViewModel.HasLink, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
