<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TunnelTimer.App.Views.WidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="18,10,18,14" RowSpacing="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="PhaseStates">
                <VisualState x:Name="Upcoming" />
                <VisualState x:Name="Imminent">
                    <VisualState.Setters>
                        <Setter Target="TimeTextBlock.Foreground" Value="{ThemeResource PhaseImminentBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Overdue">
                    <VisualState.Setters>
                        <Setter Target="TimeTextBlock.Foreground" Value="{ThemeResource PhaseOverdueBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Grip: signals that the widget can be dragged, and carries the brand spectrum. -->
        <Border
            Grid.Row="0"
            Width="56"
            Height="6"
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Background="{ThemeResource RainbowBrush}"
            CornerRadius="3" />

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            MaxLines="1"
            Style="{ThemeResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.Title, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />

        <TextBlock
            x:Name="TimeTextBlock"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource DisplayFontFamily}"
            FontSize="64"
            FontWeight="Bold"
            Foreground="{ThemeResource PhaseUpcomingBrush}"
            Text="{x:Bind ViewModel.TimeText, Mode=OneWay}"
            Typography.NumeralAlignment="Tabular" />

        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,12"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{ThemeResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.StartText, Mode=OneWay}" />

        <!-- Without a link: "I'm in". With a link: "Join meeting" plus "I'm already in". -->
        <StackPanel x:Name="ActionsPanel" Grid.Row="4" Spacing="2">
            <Button
                x:Uid="AcknowledgeButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.AcknowledgeCommand}"
                Style="{StaticResource PillAccentButtonStyle}"
                Visibility="{x:Bind VisibleWhenFalse(ViewModel.HasLink), Mode=OneWay}" />
            <Button
                x:Uid="JoinButton"
                HorizontalAlignment="Stretch"
                Command="{x:Bind ViewModel.JoinCommand}"
                Style="{StaticResource PillAccentButtonStyle}"
                Visibility="{x:Bind ViewModel.HasLink, Mode=OneWay}" />
            <HyperlinkButton
                x:Uid="AlreadyInButton"
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.AcknowledgeCommand}"
                Visibility="{x:Bind ViewModel.HasLink, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</UserControl>
