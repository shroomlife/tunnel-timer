<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TunnelTimer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Brand: ink is the app's accent, so primary buttons, switches, focus marks and
                links all use it instead of the user's Windows accent color.
            -->
            <Color x:Key="SystemAccentColor">#1B1A2E</Color>
            <Color x:Key="SystemAccentColorDark1">#1B1A2E</Color>
            <Color x:Key="SystemAccentColorDark2">#14132A</Color>
            <Color x:Key="SystemAccentColorDark3">#0D0C1C</Color>
            <Color x:Key="SystemAccentColorLight1">#3A3958</Color>
            <Color x:Key="SystemAccentColorLight2">#5B5A80</Color>
            <Color x:Key="SystemAccentColorLight3">#8483A8</Color>

            <!-- Outfit (SIL Open Font License) for the name and the digits. -->
            <FontFamily x:Key="DisplayFontFamily">ms-appx:///Assets/Fonts/Outfit.ttf#Outfit</FontFamily>

            <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>

            <Style x:Key="PillButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,0" />
            </Style>
            <Style x:Key="PillAccentButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="InkBrush" Color="#1B1A2E" />
                    <SolidColorBrush x:Key="PaperBrush" Color="#FBF8F3" />
                    <SolidColorBrush x:Key="CardBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#EDE7DC" />
                    <!-- Small secondary text. Darker than the default secondary colour: without ClearType, thin light text looks soft at 100 % scaling. -->
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4A4960" />

                    <!-- The spectrum, used once per surface. -->
                    <LinearGradientBrush x:Key="RainbowBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF5E5B" />
                        <GradientStop Offset="0.2" Color="#FF9F1C" />
                        <GradientStop Offset="0.4" Color="#FFD23F" />
                        <GradientStop Offset="0.6" Color="#3DDC97" />
                        <GradientStop Offset="0.8" Color="#2EC4F1" />
                        <GradientStop Offset="1" Color="#7B61FF" />
                    </LinearGradientBrush>

                    <!--
                        The spectrum twice in a row, each run ending in the colour it starts
                        with. A surface twice as wide as its window can slide by half its width
                        and look the same again, which makes an endless loop without a seam.
                    -->
                    <LinearGradientBrush x:Key="RainbowLoopBrush" StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF5E5B" />
                        <GradientStop Offset="0.0833" Color="#FF9F1C" />
                        <GradientStop Offset="0.1667" Color="#FFD23F" />
                        <GradientStop Offset="0.25" Color="#3DDC97" />
                        <GradientStop Offset="0.3333" Color="#2EC4F1" />
                        <GradientStop Offset="0.4167" Color="#7B61FF" />
                        <GradientStop Offset="0.5" Color="#FF5E5B" />
                        <GradientStop Offset="0.5833" Color="#FF9F1C" />
                        <GradientStop Offset="0.6667" Color="#FFD23F" />
                        <GradientStop Offset="0.75" Color="#3DDC97" />
                        <GradientStop Offset="0.8333" Color="#2EC4F1" />
                        <GradientStop Offset="0.9167" Color="#7B61FF" />
                        <GradientStop Offset="1" Color="#FF5E5B" />
                    </LinearGradientBrush>

                    <!-- One brush per countdown phase, dark enough for large digits on a light surface. -->
                    <LinearGradientBrush x:Key="PhaseUpcomingBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#0B8F6A" />
                        <GradientStop Offset="0.5" Color="#0A84C6" />
                        <GradientStop Offset="1" Color="#5B4BDB" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PhaseImminentBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#D97706" />
                        <GradientStop Offset="1" Color="#C2410C" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PhaseOverdueBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#DC2626" />
                        <GradientStop Offset="0.5" Color="#C026D3" />
                        <GradientStop Offset="1" Color="#7C3AED" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <!-- High contrast: colors follow the system, the phase is carried by the text alone. -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PaperBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RainbowBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RainbowLoopBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PhaseUpcomingBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PhaseImminentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PhaseOverdueBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
